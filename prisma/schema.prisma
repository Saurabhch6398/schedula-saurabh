datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  phone          String?
  role           String          // "DOCTOR" | "PATIENT" | "ADMIN"
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
  notifications  Notification[]

  @@map("users")
}

model DoctorProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  fullName        String   @map("full_name")
  specialization  String
  experience      Int
  qualification   String
  consultationFee Float    @map("consultation_fee")
  availability    String
  profileDetails  String?  @map("profile_details")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringAvailabilities RecurringAvailability[]
  customAvailabilities    CustomAvailability[]
  waveSchedules          WaveSchedule[]
  appointments           Appointment[]
  appointmentQueues      AppointmentQueue[]

  schedulingType  SchedulingType @default(STREAM) @map("scheduling_type")
  slotDuration    Int?           @map("slot_duration")
  bufferTime      Int?           @default(0) @map("buffer_time")

  @@map("doctor_profiles")
}

model RecurringAvailability {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int           @map("doctor_profile_id")
  dayOfWeek       String        // MONDAY, TUESDAY, etc.
  startTime       String        // "HH:MM"
  endTime         String        // "HH:MM"
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@map("recurring_availabilities")
}

model CustomAvailability {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int           @map("doctor_profile_id")
  date            DateTime      @db.Date
  startTime       String?       // "HH:MM" (null when unavailable)
  endTime         String?       // "HH:MM" (null when unavailable)
  isAvailable     Boolean       @default(true) @map("is_available")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@map("custom_availabilities")
}

model PatientProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  fullName   String   @map("full_name")
  age        Int
  gender     String
  contact    String
  healthInfo String?  @map("health_info")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  appointmentQueues AppointmentQueue[]

  @@map("patient_profiles")
}

enum SchedulingType {
  STREAM
  WAVE
}

enum AppointmentType {
  STREAM
  WAVE
}

model WaveSchedule {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int           @map("doctor_profile_id")
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  maxCapacity     Int           @map("max_capacity")
  createdAt       DateTime      @default(now()) @map("created_at")

  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@map("wave_schedules")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id               Int             @id @default(autoincrement())
  doctorProfileId  Int             @map("doctor_profile_id")
  patientProfileId Int             @map("patient_profile_id")
  appointmentType  AppointmentType @map("appointment_type")
  slotStart        DateTime?       @map("slot_start")
  slotEnd          DateTime?       @map("slot_end")
  tokenNumber      Int?            @map("token_number")
  waveScheduleId   Int?            @map("wave_schedule_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  status             AppointmentStatus @default(BOOKED)
  bookingSource      String            @default("ONLINE") @map("booking_source")
  cancellationReason String?           @map("cancellation_reason")
  cancelledAt        DateTime?         @map("cancelled_at")

  diagnosis    String?
  prescription String?
  followUp     String? @map("follow_up")

  originalSlotStart      DateTime?          @map("original_slot_start")
  originalSlotEnd        DateTime?          @map("original_slot_end")
  originalTokenNumber    Int?               @map("original_token_number")
  originalWaveScheduleId Int?               @map("original_wave_schedule_id")
  reschedulingMetadata   String?            @map("rescheduling_metadata")
  isRescheduled          Boolean            @default(false) @map("is_rescheduled")
  rescheduleAccepted     Boolean?           @map("reschedule_accepted")
  wasAutoRescheduled     Boolean            @default(false) @map("was_auto_rescheduled")
  previousDate           String?            @map("previous_date")
  previousStartTime      String?            @map("previous_start_time")
  previousEndTime        String?            @map("previous_end_time")
  appointmentQueues      AppointmentQueue[]

  doctorProfile    DoctorProfile   @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientProfile   PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  waveSchedule     WaveSchedule?   @relation(fields: [waveScheduleId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model AppointmentQueue {
  id                    Int             @id @default(autoincrement())
  doctorProfileId       Int             @map("doctor_profile_id")
  patientProfileId      Int             @map("patient_profile_id")
  appointmentId         Int?            @map("appointment_id")
  queueType             String          @map("queue_type") // "READY" | "RESCHEDULE" | "CANCELLATION"
  status                String          @default("PENDING") @map("status") // "PENDING" | "OFFERED" | "ACCEPTED" | "REJECTED"
  offeredSlotStart      DateTime?       @map("offered_slot_start")
  offeredSlotEnd        DateTime?       @map("offered_slot_end")
  offeredWaveScheduleId Int?            @map("offered_wave_schedule_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  doctorProfile         DoctorProfile   @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientProfile        PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  appointment           Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("appointment_queues")
}

model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  appointmentId Int?     @map("appointment_id")
  title         String
  message       String
  type          String   // APPOINTMENT_BOOKED, APPOINTMENT_CANCELLED, APPOINTMENT_RESCHEDULED
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}


