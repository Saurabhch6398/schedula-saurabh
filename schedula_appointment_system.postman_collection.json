          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.token) {",
                  "    pm.globals.set(\"token\", responseJson.token);",
                  "    console.log(\"Authorization Token updated globally!\");",
                  "}"
                ],
